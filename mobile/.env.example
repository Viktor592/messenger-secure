# Messenger Secure Mobile - Environment Variables

# API Server
REACT_APP_API_SERVER=http://localhost:3000
REACT_APP_SOCKET_SERVER=http://localhost:3000

# Environment
REACT_APP_ENV=development

# Feature flags
REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_WEBRTC=true
REACT_APP_ENABLE_VOICE_CALLS=true

# WebRTC configuration
REACT_APP_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
REACT_APP_TURN_SERVER=turn:your.turn.server:3478
REACT_APP_TURN_USERNAME=username
REACT_APP_TURN_PASSWORD=password

# Crypto configuration
REACT_APP_CRYPTO_ALGORITHM=ChaCha20Poly1305
REACT_APP_KEY_EXCHANGE=Noise-NN

# Storage encryption
REACT_APP_STORAGE_ENCRYPTION_ENABLED=true
REACT_APP_STORAGE_TTL_DAYS=7

# Logging
REACT_APP_LOG_LEVEL=info
REACT_APP_LOG_TO_FILE=false

# Analytics (optional)
REACT_APP_ENABLE_ANALYTICS=false
