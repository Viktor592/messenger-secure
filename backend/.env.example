# Database
DATABASE_URL="postgresql://user:password@localhost:5432/messenger_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"

# Twilio SMS Verification
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# JWT Secrets
JWT_SECRET="your_super_secret_jwt_key_change_in_production"
JWT_EXPIRE_ACCESS="15m"
JWT_EXPIRE_REFRESH="30d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="debug"

# Email (optional, for alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Sentry (optional, for error tracking)
SENTRY_DSN=""

# Feature Flags
FEATURE_SMS_VERIFICATION_ENABLED=true
FEATURE_VOICE_CALLS_ENABLED=true
FEATURE_VIDEO_CALLS_ENABLED=true
FEATURE_GROUPS_ENABLED=true

# Cleanup Jobs
JOB_MESSAGE_CLEANUP_DAYS=7
JOB_SESSION_CLEANUP_DAYS=30
JOB_AUDIT_LOG_CLEANUP_DAYS=7
